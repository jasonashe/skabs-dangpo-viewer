{
  "root_paragraph_heading": "32_ཁ་ཅིག་འཕགས། དུམ་མཚན་དང་པོ། 59",
  "root_paragraph": "ཁ་ཅིག །འཕགས་པ་ཐོགས་མེད་ཀྱིས་མཛད་པའི་དེ་ཉིད་རྣམ་ངེས་དེ་མདོ་རྒྱན་སྦྱར་བའི་འགྲེལ་པ་ཡིན་ཟེར་བ་མི་འཐད་དེ། མདོ་རྒྱན་སྦྱར་བའི་འགྲེལ་པ་བཅུ་གཉིས་དང་༑ མ་སྦྱར་བའི་འགྲེལ་པ་དགུ་ཞེས་མཁས་པ་རྣམས་ལ་གྲགས་ཤིང་། མདོ་རྒྱན་སྦྱར་བའི་ཐོག་མ་ཉི་ཁྲི་སྣང་བ་ནས་འཛིན་པར་མཁས་པ་རྣམས་ལ་གྲགས་པ་ལྟར་འཐད་པའི་ཕྱིར༑ དེ་ལྟར་མ་ཡིན་ན།བསྟན་བཅོས་ཆེན་པོའ་ིརྣམ་བཤད་མཛད། །ཅེས་པའི་སྐབས་ཀྱི་བསྟན་བཅོས་དེ་མངོན་རྟོགས་རྒྱན་ལ་བྱེད་དགོས་ལ། དེ་ལྟར་ན།བསྟན་བཅོས་མཐའ་དག་འདི་དེ་ལྟར། །ཞེས་དང་།བསྟན་བཅོས་མཐའ་དག་མ་རྙེད་པར། །ཞེས་པའི་བསྟན་བཅོས་རྣམས་ཀྱང་མངོན་རྟོགས་རྒྱན་ལ་བྱེད་དགོས་པར་ཐལ་བའི་སྐྱོན་ཡོད་པའི་ཕྱིར་དང་། ཤེར་འབྱུང་གི་བསྡུས་དོན་ལས་ཀྱང་།འཕགས་པ་དང་སློབ་དཔོན་དག་གིས་མངོན་པར་རྟོགས་པ་དང་སྦྱར་བ་ལ་མ་བལྟོས་པར་བཤད་པའི་ཕྱིར་དང་། ཞེས་དེ་ཉིད་རྣམ་ངེས་མདོ་རྒྱན་མ་སྦྱར་བའི་འགྲེལ་པར་གསལ་བར་བཤད་པའི་ཕྱིར། ཁ་ཅིག །དེ་ཉིད་རྣམ་ངེས་དེ་ཉི་ཁྲི་ཁོ་ནའི་འགྲེལ་པ་ཡིན་གསུངས་པ་མི་འཐད་དེ། གསེར་ཕྲེང་ལས། འདི་ལ་ཉི་ཁྲི་དེ་ཉིད་རྣམ་ངེས་ཟེར་བ་ནི་བརྟག་དགོས་སོ། །ཞེས་གསུངས་པའི་ཕྱིར།",
  "root_paragraph_page": "59",
