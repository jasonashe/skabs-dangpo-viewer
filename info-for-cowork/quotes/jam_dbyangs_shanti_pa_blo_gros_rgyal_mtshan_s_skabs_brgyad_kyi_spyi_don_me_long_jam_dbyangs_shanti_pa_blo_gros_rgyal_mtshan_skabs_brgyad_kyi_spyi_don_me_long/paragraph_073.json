{
  "root_paragraph_heading": "74_རོང་ཊཱིཀ་པ། དུམ་མཚན་དང་པོ། 82",
  "root_paragraph": "རོང་ཊཱིཀ་པ་ན་རེ། ཡོད་ན་གཅིག་དང་དུ་མ་གང་རུང་གིས་ཁྱབ་པ་འཇལ་བའི་ཚད་མས། བདེན་པར་ཡོད་ན་བདེན་པའི་གཅིག་དང་བདེན་པའི་དུ་མ་གང་རུང་དུ་མ་ཁྱབ་པར་འཛིན་པའི་སྒྲོ་འདོགས་གཅོད་པ་ཡིན་ནོ། །ཟེར་ན། བྱས་ན་མི་རྟག་པས་ཁྱབ་པ་འཇལ་བའི་ཚད་མས། སྒྲ་བྱས་ན་མི་རྟག་པས་མ་ཁྱབ་པར་འཛིན་པའི་སྒྲོ་འདོགས་གཅོད་པར་ཐལ། དམ་བཅའ་འཐད་པའི་ཕྱིར། འདོད་ན། དེས་སྒྲ་ལ་རྟག་འཛིན་གྱི་སྒྲོ་འདོགས་གཅོད་པར་ཐལ་ལོ། །འདོད་ན། བྱས་པའི་རྟགས་ལས་སྒྲ་མི་རྟག་རྟོགས་ཀྱི་རྗེས་དཔག་གིས་སྒྲ་རྟག་འཛིན་གྱི་སྒྲོ་འདོགས་གསར་དུ་མི་གཅོད་པར་ཐལ་ལོ། །",
  "root_paragraph_page": "82",
