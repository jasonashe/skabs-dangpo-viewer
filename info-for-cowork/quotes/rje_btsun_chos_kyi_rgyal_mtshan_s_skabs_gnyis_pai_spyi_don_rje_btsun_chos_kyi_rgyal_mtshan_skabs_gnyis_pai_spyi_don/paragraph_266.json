{
  "root_paragraph_heading": "267_གཉིས་པ་ནི། དུམ་མཚན་དང་པོ། 211",
  "root_paragraph": "གཉིས་པ་ནི། ཐེག་ཆེན་སེམས་བསྐྱེད་ཀྱི་སེམས་རྟེན་དུ་གྱུར་པའི་བསམ་གཏན་གྱི་ཉེར་བསྡོགས། བསམ་གཏན་གྱི་དངོས་གཞི་ཅི་རིགས་པ་ཡོད་ཅིང་། དེ་ལ་འདོད་སེམས་མེད་དེ། ཐེག་ཆེན་སེམས་བསྐྱེད་ཐོབ་ན་བསམ་གཏན་གྱི་ཉེར་བསྡོགས་ཐོབ་པས་ཁྱབ་པའི་ཕྱིར་ཏེ། དེ་ཐོབ་ན་ཞི་ལྷག་ཟུང་འབྲེལ་ཐོབ་པས་ཁྱབ་པའི་ཕྱིར་ཏེ། རྣམ་བཤད་ལས༑སྦྱོར་བ་ཞེས་པ་ནི་ཞི་ལྷག་ཟུང་དུ་འབྲེལ་བའི་དོན་བསྟན་པའོ། །ཞེས་གསུངས་པས། རྣམ་རྫོགས་སྦྱོར་བ་ཐོབ་ན་ཞི་ལྷག་ཟུང་འབྲེལ་ཐོབ་པས་ཁྱབ་པར་བསྟན་པའི་ཕྱིར།",
  "root_paragraph_page": "211",
