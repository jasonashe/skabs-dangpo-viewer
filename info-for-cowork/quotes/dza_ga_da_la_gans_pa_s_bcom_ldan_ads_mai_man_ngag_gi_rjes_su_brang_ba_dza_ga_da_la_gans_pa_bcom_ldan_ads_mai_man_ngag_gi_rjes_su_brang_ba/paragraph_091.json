{
  "root_paragraph_heading": "92_ཁ་ཅིག་མཁྱེན། དུམ་མཚན་དང་པོ། 92",
  "root_paragraph": "ཁ་ཅིག །མཁྱེན་གསུམ་ནི་དུས་གསུམ་གྱི་འཕགས་པ་ཐམས་ཅད་ཀྱི་རྒྱུད་དང་འབྲེལ་བས་རྒྱ་ཆེ། སྦྱོར་བཞི་དང་ཆོས་སྐུ་རྒྱན་གྱི་ཆེད་དུ་བྱ་བའི་གདུལ་བྱ་ཁོ་ནའི་རྒྱུད་ལ་ཡོད་པས་རྒྱ་ཆུང་བས། རྒྱ་ཆེ་བ་མཁྱེན་གསུམ་གྱིས་རྒྱ་ཆུང་བ་སྦྱོར་བ་བཞི་དང་ཆོས་སྐུ་བསྡུས་པ་དེ་དེའི་དོན་ཡིན་ཏེ། དཔེར་ན་རྒྱ་མཚོས་ཆུ་ཐིག་བསྡུས་པ་བཞིན། ཞེས་ཟེར་བ་མི་འཐད་དེ། དེ་གསུམ་གྱིས་བརྒྱད་བསྡུས་པའི་དོན་མིན་ལ། གསུམ་གྱིས་ལྔ་བསྡུས་པའི་དོན་ཡིན་པའི་ཕྱིར། དུས་གསུམ་གྱི་འཕགས་པ་རྣམ་མཁྱེན་དང་ལམ་ཤེས་རང་རྒྱུད་ལ་སྐྱེད་པ་རྣམས་ཀྱིས། སྦྱོར་བཞི་དང་ཡེ་ཤེས་ཆོས་སྐུ་ངེས་པར་རང་རྒྱུད་ལ་སྐྱེད་པར་བྱེད་དགོས་པའི་ཕྱིར་དང་། དེ་ལས་ལྡོག་སྟེ་ཁས་བླངས་ཀྱང་གནོད་བྱེད་མེད་པའི་ཕྱིར།",
  "root_paragraph_page": "92",
  "paragraph_key": "e0ef9660fe31d3aa",
