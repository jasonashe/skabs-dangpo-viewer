{
  "root_paragraph_heading": "18_གཉིས་པ་ལ། དུམ་མཚན་དང་པོ། 50",
  "root_paragraph": "གཉིས་པ་ལ། བསྟན་བཅོས་འདི་ཆོས་ཅན། ཁྱོད་ལ་ཤེས་རབ་ཀྱི་ཕ་རོལ་ཏུ་ཕྱིན་པ་ཞེས་བརྗོད་པའི་རྒྱུ་མཚན་ཡོད་དེ། ཁྱོད་ཀྱིས་གཞུང་ཤེར་ཕྱིན་གྱི་དགོངས་པ་འགྲེལ་བར་བྱེད་པས་ན་དེ་ལྟར་བརྗོད་པའི་ཕྱིར། ཁྱོད་ལ་མན་ངག་ཅེས་བརྗོད་པའི་རྒྱུ་མཚན་ཡོད་དེ། ཁྱོད་མདོ་དོན་བདེ་བླག་ཏུ་རྟོགས་པའི་མན་ངག་སྟེ་ཐབས་ཡིན་པས་ན་དེ་ལྟར་བརྗོད་པའི་ཕྱིར། ཁྱོད་ལ་བསྟན་བཅོས་ཞེས་བརྗོད་པའི་རྒྱུ་མཚན་ཡོད་དེ། འཆོས་སྐྱོབ་ཀྱི་ཡོན་ཏན་གཉིས་དང་ལྡན་པའི་ངག་རྣམ་དག་ཡིན་པས་ན་དེ་ལྟར་བརྗོད་པའི་ཕྱིར། ཁྱོད་ལ་མངོན་པར་རྟོགས་པ་ཞེས་བརྗོད་པའི་རྒྱུ་མཚན་ཡོད་དེ། ཁྱོད་ཀྱིས་དོན་མངོན་པར་རྟོགས་པ་བརྒྱད་བརྗོད་བྱར་བྱེད་པས་ན་དེ་ལྟར་བརྗོད་པའི་ཕྱིར། དེ་ཆོས་ཅན། ཁྱོད་ལ་རྒྱན་ཅེས་བརྗོད་པའི་རྒྱུ་མཚན་ཡོད་དེ། དཔེར་ན་རང་བཞིན་གྱི་རྒྱན་སྐྱེས་བུའི་ལུས་བཟང་པོ་ལ། མཛེས་བྱེད་ཀྱི་རྒྱན་གདུ་བུ་ལ་སོགས་པས་སྤྲས་པ་དེ་ཉིད་གསལ་བྱེད་ཀྱི་རྒྱན་མེ་ལོང་ལ་སོགས་པའི་ནང་དུ་ཤར་བ་ན་དགའ་བའི་རྒྱན་འདོད་པ་པོ་དགའ་བ་སྐྱེད་པ་བཞིན་དུ། རང་བཞིན་གྱི་རྒྱན་ཡུམ་གྱི་ལུས་བཟང་པོ་ལ་མཛེས་བྱེད་ཀྱི་རྒྱན་དངོས་བརྒྱད་དོན་བདུན་ཅུས་སྤྲས་པ་དེ་ཉིད་གསལ་བྱེད་ཀྱི་རྒྱན་བསྟན་བཅོས་འདིའི་ནང་དུ་ཤར་བ་ན། དགའ་བའི་རྒྱན་ལྟ་བ་པོ་ལ་དགའ་བ་སྐྱེད་པས་ན་དེ་ལྟར་བརྗོད་པའི་ཕྱིར། དེ་ལྟར་ཡང་། མདོ་སྡེའི་རྒྱན་ལས།གཟུགས་རྒྱན་རང་བཞིན་ཡོན་ཏན་ལྡན་པ་མེ་ལོང་ནང་སོང་བ། །མཐོང་བའི་དབང་གིས་མི་རྣམས་རབ་ཏུ་དགའ་བའི་མཆོག་སྐྱེད་པ། །དེ་བཞིན་ལེགས་གསུངས་རྟག་ཏུ་རང་བཞིན་ཡོན་ཏན་ལྡན་པ་ཡི། །ཆོས་ཀྱང་དོན་རྣམས་ཕྱེ་བས་མཁས་རྣམས་འདི་ན་དགའ་མཆོག་སྐྱེད། །ཅེས་གསུངས་པའི་ཕྱིར། འགྲེལ་པ་འདི་ཆོས་ཅན༑ ཁྱོད་ལ་འགྲེལ་པ་ཞེས་བརྗོད་པའི་རྒྱུ་མཚན་ཡོད་དེ། ཁྱོད་ཀྱིས་བསྟན་བཅོས་མངོན་རྟོགས་རྒྱན་གྱི་ཚིག་དོན་གཉིས་ཀྱི་ནང་ནས་དོན་གྱི་ཆ་གཙོ་བོར་འགྲེལ་བར་བྱེད་པས་ན་དེ་ལྟར་བརྗོད་པའི་ཕྱིར།",
