{
  "root_paragraph_heading": "387_ཁ་ཅིག་ཀུན། དུམ་མཚན་དང་པོ། 280",
  "root_paragraph": "ཁ་ཅིག །ཀུན་རྫོབ་པའི་དགེ་འདུན་དཀོན་མཆོག་དང་། དོན་དམ་པའི་དགེ་འདུན་དཀོན་མཆོག་འགལ་ཟེར་ན་མི་འཐད་དེ། བྱང་འཕགས་ཡིན་ན། དོན་དམ་པའི་དགེ་འདུན་དཀོན་མཆོག་ཡིན་དགོས་པའི་ཕྱིར་ཏེ། དེ་ཡིན་ན་དོན་དམ་པའི་བྱང་ཆུབ་སེམས་དཔའ་ཡིན་དགོས་པའི་ཕྱིར་ཏེ། དོན་དམ་སེམས་བསྐྱེད་ཐོབ་པའི་བྱང་ཆུབ་སེམས་དཔའ་ལ་དེ་ལྟར་དགོས་པའི་ཕྱིར་ཏེ། འཇུག་པ་ལས།དེ་ནས་བཟུང་སྟེ་དེ་ནི་ཐོབ་པར་གྱུར་པ་ཡི། །བྱང་ཆུབ་སེམས་དཔའ་ཞེས་བྱའི་སྒྲ་ཉིད་ཀྱིས་བསྙད་དོ། །ཞེས་གསུངས་པའི་ཕྱིར།",
  "root_paragraph_page": "280",
