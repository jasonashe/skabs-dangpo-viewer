{
  "root_paragraph_heading": "16_བཞི་པ་འགྲེལ། དུམ་མཚན་དང་པོ། 49",
  "root_paragraph": "བཞི་པ་འགྲེལ་པ་གང་གི་རྗེས་སུ་འབྲང་བ་ནི། འོ་ན་མངོན་རྟོགས་རྒྱན་ལ་འགྲེལ་པ་དེ་ཙམ་ཡོད་ན། རང་ཉིད་འགྲེལ་པ་གང་གི་རྗེས་སུ་འབྲངས་ནས་མངོན་རྟོགས་རྒྱན་འཆད་པ་ཡིན་ཞེ་ན། རྒྱལ་བའི་སྲས་པོ་སེང་གེ་བཟང་པོས་མཛད་པའི་འགྲེལ་པ་དོན་གསལ་གྱི་རྗེས་སུ་འབྲངས་ནས་འཆད་པ་ཡིན་ཏེ། འགྲེལ་པ་འདི་ཚིག་ཉུང་ཞིང་དོན་འདྲིལ་ལ་དོན་གསལ་བས་ན་འགྲེལ་པ་གཞན་ལས་ཁྱད་དུ་འཕགས་པའི་ཕྱིར།",
  "root_paragraph_page": "49",
