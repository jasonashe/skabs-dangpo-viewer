{
  "root_paragraph_heading": "127_བཞི་པ་ནི། དུམ་མཚན་དང་པོ། 112",
  "root_paragraph": "བཞི་པ་ནི། བྱེ་བྲག་སྨྲ་བ་ཁ་ཅིག །ཤླཽ་ཀ་སྟོང་ཕྲག་དྲུག་དྲུག་ལ་ཆོས་ཕུང་རེ་རེའི་ཚད་དུ་འཇོག་སྟེ། ཤཱ་རིའི་བུས་མཛད་པའི་ཆོས་ཀྱི་ཕུང་པོ་ཞེས་པའི་བསྟན་བཅོས་དེ་ཆོས་ཕུང་གཅིག་གི་ཚད་ཡིན་པས་དེ་ལ་དེ་ལྟར་ཡོད་པའི་ཕྱིར། ཞེས་ཟེར། ཁ་ཅིག །ཕུང་ཁམས་སྐྱེ་མཆེད་ལས་བརྩམས་པའི་གཏམ་རྒྱུད་ཆ་ཚང་བ་རེ་སྟོན་པའི་གསུང་རབ་ལ་ཆོས་ཕུང་རེ་རེའི་ཚད་དུ་འཇོག་གོ །ཞེས་ཟེར་ཏེ། མཛོད་ལས།ཁ་ཅིག་བསྟན་བཅོས་ཚད་ཅེས་ཟེར། །ཕུང་པོ་ལ་སོགས་གཏམ་རེ་ཡིན། །ཞེས་གསུངས།",
  "root_paragraph_page": "112",
