{
  "root_paragraph_heading": "14_ཁ་ཅིག་ཕྱི། དུམ་མཚན་དང་པོ། 48",
  "root_paragraph": "ཁ་ཅིག །ཕྱི་མ་འདི་རྒྱན་གྱི་འགྲེལ་པར་མི་འཐད་དེ། འདི་ཐུབ་པའི་གསུང་རབ་སྤྱིའི་དགོངས་འགྲེལ་ཡིན་པའི་ཕྱིར་ན། སྐྱོན་མེད་དེ། འདིའི་ལེའུ་ཕྱི་མ་གསུམ་ལས་གཙོ་ཆེར་མངོན་རྟོགས་རྒྱན་གྱི་དོན་རྣམས་བསྟན་པས་ན། དེ་རྒྱན་གྱི་འགྲེལ་པར་བགྲངས་པའི་ཕྱིར། ཁ་ཅིག །འདི་མདོ་རྒྱན་སྦྱར་བའི་འགྲེལ་པ་ཡིན་ཏེ། འདིར་གང་ཟག་ལ་སོགས་པ་འགའ་ཟུང་མདོ་དང་སྦྱར་བའི་ཕྱིར་ན་མ་ཁྱབ་སྟེ། འདིས་ཕལ་ཆེར་མདོ་དང་མ་སྦྱར་བར་བཤད་པའི་ཕྱིར།",
  "root_paragraph_page": "48",
  "paragraph_key": "a7b13b8eb2efb5a5",
