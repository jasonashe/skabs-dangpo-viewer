{
  "root_paragraph_heading": "375_གང་ཟག་གི། དུམ་མཚན་དང་པོ། 273",
  "root_paragraph": "གང་ཟག་གི་བདག་མེད་མངོན་སུམ་དུ་རྟོགས་པའི་ཡེ་ཤེས་ཆོས་ཅན། ལམ་གྱི་རྣམ་པ་ཞེས་བྱ་སྟེ། ཐར་པར་བགྲོད་པར་བྱེད་པའི་ལམ་གྱི་རིགས་སུ་གནས་པའི་ཕྱིར། རིག་པའི་རྣམ་པ་ཞེས་བྱ་སྟེ། ཉོན་མོངས་པའི་དངོས་གཉེན་དུ་དགོས་པའི་ཕྱིར། སྒྲུབ་པའི་རྣམ་པ་ཞེས་བྱ་སྟེ། སེམས་ཀྱི་གནས་ལུགས་ཕྱིན་ཅི་མ་ལོག་པར་སྒྲུབ་པའི་ཕྱིར། ངེས་པར་འབྱིན་པའི་རྣམ་པ་ཞེས་བྱ་སྟེ། སྡུག་བསྔལ་གཏན་ཟད་དུ་བྱེད་པའི་ལམ་ཡིན་པའི་ཕྱིར།",
  "root_paragraph_page": "273",
  "paragraph_key": "3895ac82e85bcda5",
