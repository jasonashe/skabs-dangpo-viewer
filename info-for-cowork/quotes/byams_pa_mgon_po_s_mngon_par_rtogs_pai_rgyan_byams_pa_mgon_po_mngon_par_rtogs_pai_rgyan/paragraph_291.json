{
  "root_paragraph_heading": "292_དྲིན་གཟོ་བ། དུམ་མཚན་དང་པོ། 228",
  "root_paragraph": "དྲིན་གཟོ་བ་ནི། སློབ་སྤྲིངས་ལས།ཉེ་དུ་འཁོར་བའི་རྒྱ་མཚོའི་ཁོངས་སུ་ཆུད་གྱུར་པ། །ཀློང་གི་ནང་དུ་ལྷུང་བ་ལྟ་བུར་སྣང་བཞིན་དུ། །སྐྱེ་འཆི་འཕོས་པས་ངོ་མ་ཤེས་པ་དེ་བོར་ནས། །གལ་ཏེ་གཅིག་ཐར་བྱེད་ན་དེ་ལས་ཁྲེལ་བོར་མེད། །ཅེས་གསུངས་པ་ལྟར། བདག་གིས་སེམས་ཅན་ཐམས་ཅད་ཀྱི་བདེ་བ་སྒྲུབ་ཅིང་སྡུག་བསྔལ་སེལ་བའི་ཐབས་ལ་འབད་དགོས་ཏེ། སེམས་ཅན་འདི་དག་ཐམས་ཅད་ནི་བདག་གི་བདེ་བ་སྒྲུབ་ཅིང་སྡུག་བསྔལ་བསལ་བའི་དྲིན་ཅན་ཤ་སྟག་ཡིན་སྙམ་དུ་བསྒོམ་པར་བྱའོ། །",
  "root_paragraph_page": "228",
