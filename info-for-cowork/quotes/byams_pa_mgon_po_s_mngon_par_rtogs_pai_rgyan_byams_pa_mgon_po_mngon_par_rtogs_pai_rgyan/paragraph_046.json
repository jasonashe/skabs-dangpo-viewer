{
  "root_paragraph_heading": "47_ཁ་ཅིག་སྐབས། དུམ་མཚན་དང་པོ། 66",
  "root_paragraph": "ཁ་ཅིག །སྐབས་འདིའི་ཐུན་མོང་བ་ཉན་ཐོས་སྡེ་གཉིས་དང་། ཐུན་མོང་མ་ཡིན་པ་དབུ་སེམས་གཉིས་ལ་བྱེད་དེ། གསེར་ཕྲེང་ལས།ཚུལ་འདི་ལྟར་ན་བཅུ་གཉིས་པོ་ཐམས་ཅད་ཀྱང་སངས་རྒྱས་ཀྱི་མཛད་པ་སྟེ་ཐུན་མོང་མ་ཡིན་པའི་ལུགས་སོ། །ཐེག་པ་ཐུན་མོང་བ་ལྟར་ན་ཀུན་བཏུས་སོགས་སུ་བཤད་པ་ལྟར་དང་པོ་དགུ་བྱང་སེམས་དང་། ཕྱི་མ་གསུམ་སངས་རྒྱས་ཀྱི་མཛད་པ་སྟེ། ཞེས་གསུངས་པ་དང་། རྣམ་བཤད་ཀྱི་ལུང་འདི་གཉིས་དོན་གཅིག་པའི་ཕྱིར། ཞེས་ཟེར་བ་མི་འཐད་དེ། མཆོད་བརྗོད་ཀྱི་ཆེད་དུ་བྱ་བའི་གདུལ་བྱ་ཉན་ཐོས་སྡེ་གཉིས་མེད་པའི་ཕྱིར།",
  "root_paragraph_page": "66",
