{
  "root_paragraph_heading": "283_ཁ་ཅིག་རྩ། དུམ་མཚན་དང་པོ། 221",
  "root_paragraph": "ཁ་ཅིག ། རྩ་བར་མ་ཁྱབ་སྟེ། ཐེག་ཆེན་སེམས་བསྐྱེད་དེ་སེམས་བྱུང་ཡིན་པའི་ཕྱིར་ཏེ། བྱང་སར།བྱང་ཆུབ་སེམས་དཔའ་རྣམས་ཀྱི་སྨོན་ལམ་ནི་སེམས་བསྐྱེད་པའོ༑ ༑ཞེས་དང་། མདོ་སྡེའི་རྒྱན་ལས།བརྟན་པ་རྣམས་ཀྱི་སྨོན་ལམ་ནི། །སེམས་པ་འདུན་དང་བཅས་པ་སྟེ། །ཞེས་དང་། དེའི་འགྲེལ་པར།ཡོན་ཏན་གསུམ་དང་གཉིས་ལ་དམིགས་པའི་འདུན་པ་དང་ལྡན་པའི་སེམས་པ་ནི་སེམས་བསྐྱེད་པ་ཞེས་བྱའོ། །ཞེས་གསུངས་པའི་ཕྱིར་ན་མ་ཁྱབ་སྟེ། དེས་ཐེག་ཆེན་སེམས་བསྐྱེད་ལ་སྨོན་ལམ་དང་འདུན་པའི་མིང་གིས་བཏགས་ནས་བསྟན་པ་ཙམ་ཡིན་པའི་ཕྱིར་ཏེ། མདོ་སྡེའི་རྒྱན་ལས།སྤྲོ་བ་ཆེ་དང་རྩོམ་པ་ཆེ། །ཞེས་སོགས་ཀྱིས་ཐེག་ཆེན་སེམས་བསྐྱེད་དེ་གཙོ་སེམས་སུ་བསྟན་པར་རྒྱན་སྣང་ལས་གསུངས་པའི་ཕྱིར། ཉི་སྣང་ལས།སེམས་བསྐྱེད་པ་ཞེས་བྱ་བ་ནི་སེམས་ནི་རྣམ་པར་ཤེས་པ་སྟེ་རྣམ་པར་རིག་པའོ་རྣམ་པར་རིག་པ་དེ་ཡང་གང་ཞེ་ན༑ ཡིད་ཀྱི་རྣམ་པར་ཤེས་པ་སྟེ། ཞེས་གསུངས་པའི་ཕྱིར།",
  "root_paragraph_page": "221",
